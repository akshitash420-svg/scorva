{
  "name": "scorva-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Scorva AI-Assisted Hackathon Evaluation SaaS Platform",
  "scripts": {
    "start": "./start.sh",
    "setup": "./scripts/setup.sh",
    "stop": "./stop.sh",
    "status": "./status.sh",
    "logs": "./scripts/logs.sh",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "start:web": "npm --prefix apps/web run start",
    "lint:web": "npm --prefix apps/web run lint",
    "test:web": "npm --prefix apps/web test",
    "dev:api": "uvicorn apps.api.main:app --reload --port 8000",
    "test:api": "pytest apps/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
