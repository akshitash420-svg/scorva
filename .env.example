# ==============================================================================
# Scorva — Platform Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Environment
# ------------------------------------------------------------------------------
SCORVA_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Scorva"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_USER=scorva
POSTGRES_PASSWORD=scorva_dev_password
POSTGRES_DB=scorva
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://scorva:scorva_dev_password@localhost:5432/scorva"

# ------------------------------------------------------------------------------
# Redis Cache & Task Broker
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# Artifact Storage (S3 / MinIO)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="scorva-artifacts"
S3_REGION="us-east-1"
# Keep participant uploads on a private persistent volume in deployments.
SUPPORT_ATTACHMENT_DIR=".run/support-attachments"

# ------------------------------------------------------------------------------
# AI Provider (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_AI_MODEL="llama3:8b"

# ------------------------------------------------------------------------------
# Security, MFA & Secret Keys
# (Generate secure 32+ byte strings in production: openssl rand -hex 32)
# In production (SCORVA_ENV=production):
#  - SECRET_KEY and ENCRYPTION_MASTER_KEY MUST NOT be default dev strings
#  - SESSION_COOKIE_SECURE MUST be true
#  - DEBUG MUST be false
# ------------------------------------------------------------------------------
SECRET_KEY="insecure-development-secret-key-change-in-production-min-32-chars"
ENCRYPTION_MASTER_KEY="insecure-encryption-key-for-dev-only-32bytes!"
SESSION_COOKIE_NAME="scorva_session"
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE="lax"

# MFA Parameters
MFA_ENROLLMENT_TTL_SECONDS=600
MFA_CHALLENGE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=5

# Trusted Reverse Proxies (for secure client IP extraction)
TRUSTED_PROXIES=["127.0.0.1","::1"]

# ------------------------------------------------------------------------------
# Secret & Key Rotation Guide
# ------------------------------------------------------------------------------
# 1. ENCRYPTION_MASTER_KEY Rotation:
#    - Authenticated AES-256-GCM is used to encrypt user TOTP secrets.
#    - To rotate: run a migration script that reads users.encrypted_mfa_secret,
#      decrypts each with the OLD key, and re-encrypts with the NEW key in a transaction.
#
# 2. SECRET_KEY Rotation:
#    - Used for token signing and CSRF tokens.
#    - Rotating SECRET_KEY immediately invalidates existing signed tokens.
#
# 3. Administrator Password / MFA Rotation:
#    - Use `PYTHONPATH=. .venv/bin/python apps/api/scripts/seed_admin.py --email <email> --password <new-pw>`
#      or perform in-app administrative reset via `/admin/users/[userId]`.
# ------------------------------------------------------------------------------
